# Copy to .env (do not commit) and load these variables before starting the app.
DB_URL=jdbc:mysql://localhost:3306/htx_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Bangkok
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://htxlamhong.vn,https://www.htxlamhong.vn
SEED_DATA=false
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-one-time-password
UPLOAD_DIR=./data/uploads
UPLOAD_PROVIDER=local
# On Render set provider=cpanel and fill these in the Render Environment panel.
CPANEL_UPLOAD_URL=
CPANEL_PUBLIC_BASE_URL=
CPANEL_UPLOAD_TOKEN=
# Enable only for the first startup after backing up existing data.
MIGRATE_EXISTING_IMAGES=false
